# ─── PostgreSQL ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@localhost:5432/secondbrain
DATABASE_URL_SYNC=postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/secondbrain

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Neo4j ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─── Elasticsearch ─────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200 

# ─── Supabase Auth ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Supabase Storage ──────────────────────────────────
# Using Supabase Storage for file uploads
SUPABASE_STORAGE_BUCKET=secondbrain-files

# ─── AI Keys ───────────────────────────────────────────
GITHUB_TOKEN=
EMBEDDING_ENDPOINT=https://models.github.ai/inference
EMBEDDING_MODEL=openai/text-embedding-3-large
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ───────────────────────────────────────────────
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
